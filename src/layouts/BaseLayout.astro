---
import { SEO } from 'astro-seo';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/blogs.css';
import '../styles/dynamic.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
}

const { title, description, image = '/assets/logo/Social-Media-Cover.png', imageAlt = title } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <link rel="icon" type="image/x-icon" href="/assets/logo/primary-logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,600;0,800;1,400&display=swap"
    />
    <script defer data-domain="johnlilly.dev" src="https://plausible.io/js/script.outbound-links.js"></script>
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      openGraph={{
        basic: { title, type: 'website', image: socialImage, url: canonical },
        image: { alt: imageAlt },
      }}
      twitter={{ card: 'summary_large_image', creator: '@johnmlilly_', site: '@johnmlilly_' }}
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      import { createIcons, icons } from 'lucide';
      createIcons({ icons });
    </script>
    <script>
      // Progressive enhancement: the hidden state (`.reveal-init`) is only
      // ever added here, so sections stay visible if this script fails to
      // load/run or IntersectionObserver isn't supported.
      if ('IntersectionObserver' in window) {
        const revealTargets = document.querySelectorAll('[data-reveal]');
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15 }
        );
        revealTargets.forEach((el) => {
          el.classList.add('reveal-init');
          observer.observe(el);
        });
      }
    </script>
  </body>
</html>
