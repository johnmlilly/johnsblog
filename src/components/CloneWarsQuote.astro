---
import { randomCloneWarsQuote } from '../data/cloneWarsQuotes';

const quote = randomCloneWarsQuote();
---

<aside class="console" aria-label="Clone Wars quote">
  <div class="console-bar">wisdom-from-the-outer-rim</div>
  <div class="console-screen">
    <img src="/assets/starwars/noun-storm-trooper-49992.svg" alt="" class="star-wars-quote__icon" />
    <blockquote>
      <p>"{quote.text}"</p>
      <span>// The Clone Wars, S{quote.season}E{quote.episode}</span>
    </blockquote>
  </div>
</aside>
