---
import type { TerminalLogo } from '../utils/terminalLogo';

interface Row {
  label: string;
  value: string;
  datetime?: string;
}

interface Props {
  logo: TerminalLogo;
  /** Shown as `handle@johnlilly`. */
  handle: string;
  rows: Row[];
  class?: string;
}

const { logo, handle, rows, class: className } = Astro.props;
---

<div class:list={['neofetch', className]}>
  <div class="neofetch-logo" style={`--logo-color: ${logo.color}`} aria-hidden="true">
    <svg viewBox={`0 0 ${logo.size} ${logo.size}`} shape-rendering="crispEdges"><path d={logo.path} /></svg>
    <span>[ {logo.label} ]</span>
  </div>
  <dl class="neofetch-info">
    <div class="neofetch-head">
      <span class="nf-user">{handle}</span>@<span class="nf-host">johnlilly</span>
    </div>
    <div class="neofetch-rule" aria-hidden="true">{'-'.repeat(handle.length + 10)}</div>
    {rows.map((row) => (
      <div class="nf-row">
        <dt>{row.label}</dt>
        <dd>{row.datetime ? <time datetime={row.datetime}>{row.value}</time> : row.value}</dd>
      </div>
    ))}
    <div class="neofetch-colors" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span>
    </div>
  </dl>
</div>
