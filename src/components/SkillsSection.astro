---
import { getCollection } from 'astro:content';
import { slugify } from '../utils/format';

const skills = (await getCollection('skills')).sort((a, b) => a.data.order - b.data.order);

const escape = (text: string) =>
  text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const punct = (text: string) => `<span class="json-punct">${text}</span>`;

// Render the skills collection as a syntax-colored JSON object.
const keyWidth = Math.max(...skills.map((s) => slugify(s.data.title).length));
const rows = skills.map((skill) => {
  const key = slugify(skill.data.title);
  const values = skill.data.skills
    .map((item) => `<span class="json-str">"${escape(item)}"</span>`)
    .join(', ');
  return `  <span class="json-key">"${key}"</span>${punct(':')}${' '.repeat(keyWidth - key.length + 1)}${punct('[')}${values}${punct(']')}`;
});
const json = `${punct('{')}\n${rows.join(',\n')}\n${punct('}')}`;
---

<pre class="json" set:html={json} />
