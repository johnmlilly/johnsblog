---
import type { CollectionEntry } from 'astro:content';
import NeofetchCard from './NeofetchCard.astro';
import { postCard } from '../utils/postCard';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description } = post.data;
---

<article class="card-post">
  <NeofetchCard {...postCard(post)} />
  <div class="card-content">
    <a href={`/blog/${post.id}/`}><h3>{title}</h3></a>
    <p class="card-intro">{description}</p>
    <a class="card-read" aria-label={`Read ${title}`} href={`/blog/${post.id}/`}>read more →</a>
  </div>
</article>
