---
import type { CollectionEntry } from 'astro:content';
import { formatIsoDate, readingMinutes } from '../utils/format';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, image, imageAlt, date } = post.data;
---

<article class="card-post">
  {image && (
    <div class="frame">
      <div class="frame-bar">
        <b>{date ? <time datetime={date.toISOString()}>{formatIsoDate(date)}</time> : post.id}</b>
        <span>{readingMinutes(post.body ?? '')} min</span>
      </div>
      <img src={image} alt={imageAlt ?? title} loading="lazy" decoding="async" />
    </div>
  )}
  <div class="card-content">
    <a href={`/blog/${post.id}/`}><h3>{title}</h3></a>
    <p class="card-intro">{description}</p>
    <a class="card-read" aria-label={`Read ${title}`} href={`/blog/${post.id}/`}>cat {post.id}.md →</a>
  </div>
</article>
