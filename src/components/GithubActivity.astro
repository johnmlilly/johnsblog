---
const GITHUB_USERNAME = 'johnmlilly';
---

<div class="github-activity" data-username={GITHUB_USERNAME}>
  <ul class="github-activity-list" id="github-activity-list" aria-live="polite">
    <li class="github-activity-item github-activity-loading">Loading recent activity…</li>
  </ul>
  <a
    class="github-activity-link"
    href={`https://github.com/${GITHUB_USERNAME}`}
    target="_blank"
    rel="noopener noreferrer"
  >
    <i data-lucide="github"></i> View full GitHub profile
  </a>
</div>

<script>
  interface GithubEvent {
    type: string;
    repo: { name: string };
    created_at: string;
    payload?: { action?: string; ref_type?: string; commits?: { message: string }[] };
  }

  function describeEvent(event: GithubEvent): string | null {
    const repo = event.repo.name;
    switch (event.type) {
      case 'PushEvent': {
        const count = event.payload?.commits?.length ?? 1;
        return `Pushed ${count} commit${count === 1 ? '' : 's'} to <strong>${repo}</strong>`;
      }
      case 'CreateEvent':
        if (event.payload?.ref_type === 'repository') return `Created repository <strong>${repo}</strong>`;
        return null;
      case 'PullRequestEvent':
        return `${event.payload?.action === 'opened' ? 'Opened' : 'Updated'} a pull request on <strong>${repo}</strong>`;
      case 'IssuesEvent':
        return `${event.payload?.action === 'opened' ? 'Opened' : 'Updated'} an issue on <strong>${repo}</strong>`;
      case 'WatchEvent':
        return `Starred <strong>${repo}</strong>`;
      case 'PublicEvent':
        return `Made <strong>${repo}</strong> public`;
      default:
        return null;
    }
  }

  function timeAgo(dateString: string): string {
    const seconds = Math.floor((Date.now() - new Date(dateString).getTime()) / 1000);
    const units: [number, string][] = [
      [31536000, 'year'],
      [2592000, 'month'],
      [86400, 'day'],
      [3600, 'hour'],
      [60, 'minute'],
    ];
    for (const [secondsInUnit, label] of units) {
      const value = Math.floor(seconds / secondsInUnit);
      if (value >= 1) return `${value} ${label}${value === 1 ? '' : 's'} ago`;
    }
    return 'just now';
  }

  async function loadGithubActivity() {
    const container = document.querySelector<HTMLElement>('.github-activity');
    const list = document.getElementById('github-activity-list');
    if (!container || !list) return;

    const username = container.dataset.username;
    try {
      const response = await fetch(`https://api.github.com/users/${username}/events/public?per_page=10`);
      if (!response.ok) throw new Error(`GitHub API responded with ${response.status}`);

      const events: GithubEvent[] = await response.json();
      const items = events
        .map((event) => ({ text: describeEvent(event), event }))
        .filter((entry): entry is { text: string; event: GithubEvent } => Boolean(entry.text))
        .slice(0, 5);

      if (items.length === 0) {
        list.innerHTML = '<li class="github-activity-item">No recent public activity to show.</li>';
        return;
      }

      list.innerHTML = items
        .map(
          ({ text, event }) => `
            <li class="github-activity-item">
              <i data-lucide="git-commit-horizontal"></i>
              <span>${text}<time datetime="${event.created_at}"> · ${timeAgo(event.created_at)}</time></span>
            </li>`
        )
        .join('');

      const { createIcons, GitCommitHorizontal } = await import('lucide');
      createIcons({ icons: { GitCommitHorizontal } });
    } catch (error) {
      list.innerHTML = '<li class="github-activity-item github-activity-error">Couldn\'t load GitHub activity right now.</li>';
    }
  }

  loadGithubActivity();
</script>
