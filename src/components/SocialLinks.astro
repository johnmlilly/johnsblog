    <i data-lucide="github"></i>
  </a>
  <a href="https://www.linkedin.com/in/johnmlilly" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
    <i data-lucide="linkedin"></i>
  </a>
  <a href="mailto:hello@johnlilly.dev" aria-label="Email">
    <i data-lucide="mail"></i>
  </a>
</div>
