---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SkillsSection from '../components/SkillsSection.astro';
import home from '../data/home.json';
import pageMeta from '../data/pages/home.json';
import { formatIsoDate, readingMinutes, slugify } from '../utils/format';

const allPosts = await getCollection('blog', ({ data }) => data.published !== false);
const featuredPosts = allPosts
  .filter((post) => post.data.featured)
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0))
  .slice(0, 6);

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((project) => project.data.featured)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);
---

<BaseLayout title={pageMeta.title} description={pageMeta.description} image={pageMeta.image}>
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-content">
          <p class="prompt">whoami</p>
          <h1>{home.hero.name}<span>_</span></h1>
          <p class="hero-greeting">{home.hero.greeting}</p>
          <p>{home.hero.description}</p>
          <p>I help <span id="hero-text">small businesses</span> create websites that work — and look — great.</p>
          <div class="hero-buttons">
            <a href={home.hero.firstCtaUrl} class="btn btn-primary">{home.hero.firstCtaText}</a>
            <a href={home.hero.secondCtaUrl} class="btn btn-outline">{home.hero.secondCtaText}</a>
          </div>
        </div>
        <div class="hero-image frame portrait">
          <div class="frame-bar"><b>photo-01</b><span>~/photos</span></div>
          <img loading="eager" fetchpriority="high" src={home.hero.image} alt="John Lilly" />
        </div>
      </div>
    </div>
  </section>

  <section id="about" data-reveal>
    <div class="container">
      <div class="box">
        <h2>{slugify(home.about.heading)}</h2>
        <div class="about-grid">
          <div class="frame">
            <div class="frame-bar"><b>photo-02</b><span>~/photos</span></div>
            <img src={home.about.image} alt="Illustration of John Lilly with his wife and three children" loading="lazy" decoding="async" />
          </div>
          <div>
            <div class="about-text">
              {home.about.description.map((paragraph) => <p>{paragraph}</p>)}
            </div>
            <a href={home.about.ctaUrl} class="btn btn-primary">{home.about.ctaText}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="services" data-reveal>
    <div class="container">
      <div class="box">
        <h2>{slugify(home.services.title)}/</h2>
        <p class="comment">{home.services.subtitle}</p>
        <p class="prompt">ls -la services/</p>
        <div class="ls-wrap">
          <table class="ls">
            <tbody>
              {home.services.cards.map((card) => (
                <tr>
                  <td class="perm" aria-hidden="true">drwxr-xr-x</td>
                  <td class="name">{slugify(card.title)}</td>
                  <td class="desc">{card.description}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <section id="projects" data-reveal>
    <div class="container">
      <div class="box">
        <h2>projects/</h2>
        <div class="section-header">
          <p class="prompt">ls projects/ --featured</p>
          <a href="/projects">view all →</a>
        </div>
        <div class="projects-grid">
          {featuredProjects.map((project) => <ProjectCard project={project} />)}
        </div>
      </div>
    </div>
  </section>

  <section id="blog" data-reveal>
    <div class="container">
      <div class="box">
        <h2>blog</h2>
        <div class="section-header">
          <p class="prompt">ls -t blog/ | head</p>
          <a href="/blog">view all →</a>
        </div>
        <ul class="log">
          {featuredPosts.map((post) => (
            <li>
              {post.data.date ? <time datetime={post.data.date.toISOString()}>{formatIsoDate(post.data.date)}</time> : <span />}
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              <span class="log-meta">{readingMinutes(post.body ?? '')} min</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="skills" data-reveal>
    <div class="container">
      <div class="box">
        <h2>skills</h2>
        <p class="prompt">cat skills</p>
        <SkillsSection />
      </div>
    </div>
  </section>

  <section class="contact-cta-section" data-reveal>
    <div class="container">
      <div class="box">
        <h2>contact</h2>
        <p class="comment">{home.contact.heading}</p>
        <p>{home.contact.description}</p>
        <a href="/contact" class="btn btn-primary btn-lg">{home.contact.cta} <span aria-hidden="true">↵</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import Typed from 'typed.js';

  new Typed('#hero-text', {
    strings: ['small businesses', 'churches', 'ministries', 'nonprofits'],
    typeSpeed: 75,
    backSpeed: 50,
    backDelay: 1500,
    startDelay: 500,
    loop: true,
    cursorChar: ' ',
  });
</script>
