---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import pageMeta from '../../data/pages/projects.json';

const projects = (await getCollection('projects')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title={pageMeta.title} description={pageMeta.description} image={pageMeta.image}>
  <section class="container snippet-container">
    <h1>Projects</h1>
    <div class="projects-grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</BaseLayout>
